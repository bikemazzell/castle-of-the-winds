{
  "name": "castle-of-the-winds",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Independent turn-based browser RPG inspired by Castle of the Winds, with new code and pixel art",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "coverage": "vitest run --coverage",
    "ci": "npm ci && npm run typecheck && npm run lint && npm test && npm run build",
    "lint": "eslint .",
    "e2e": "tsx tools/e2e/run-smoke.ts",
    "e2e:preview": "E2E_MODE=preview tsx tools/e2e/run-smoke.ts",
    "e2e:mobile": "tsx tools/e2e/run-mobile.ts",
    "e2e:campaign": "tsx tools/e2e/run-campaign.ts",
    "e2e:campaign2": "tsx tools/e2e/run-campaign2.ts",
    "ui-review": "tsx tools/e2e/run-ui-review.ts",
    "e2e:release": "tsx tools/e2e/run-release.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "puppeteer-core": "^25.17.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
